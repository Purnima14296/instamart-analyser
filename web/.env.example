# Leave empty for local Vite proxy (npm run dev → /api → :8000)
# Production (Vercel): set to your Railway public URL, no trailing slash
# Example: https://instamart-analyser-api.up.railway.app
VITE_API_BASE=

# Optional — must match Railway API_*_TOKEN values when you rotate away from demos
# VITE_API_VIEWER_TOKEN=viewer-demo-token
# VITE_API_REVIEWER_TOKEN=reviewer-demo-token
# VITE_API_ADMIN_TOKEN=admin-demo-token
