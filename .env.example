# Optional Reddit API credentials (for live Reddit ingestion when public API is blocked)
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=InstamartAnalyser/0.1

# Groq LLM (Phase 2 enrichment and Phase 3+ insight generation)
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_MAX_TOKENS=2048
# GROQ_TEMPERATURE=0.1
# GROQ_MAX_REQUESTS_PER_MINUTE=10
# GROQ_ENRICHMENT_DAILY_CAP=130
# GROQ_DAILY_REQUEST_RESERVE=50
# GROQ_ENRICHMENT_BATCH_SIZE=8

# Phase 6A API auth tokens (optional; demo defaults exist in code)
# API_VIEWER_TOKEN=viewer-demo-token
# API_REVIEWER_TOKEN=reviewer-demo-token
# API_ADMIN_TOKEN=admin-demo-token

# CORS — comma-separated exact origins (Vercel production + local)
# API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-app.vercel.app
# Preview deployments (default allows https://*.vercel.app)
# API_CORS_ORIGIN_REGEX=https://.*\.vercel\.app
